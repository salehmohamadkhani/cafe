# Flask session key. Use a long random value in production.
SECRET_KEY=change-me

# SQLite defaults are created inside instance/ when these are omitted.
# CAFE_DB_URI=sqlite:///C:/absolute/path/to/cafe.db
# CAFE_MASTER_DB_URI=sqlite:///C:/absolute/path/to/master.db
# CAFE_TENANTS_DIR=C:/absolute/path/to/tenants

# Initial master bootstrap values. The local demo uses admin/admin.
# Change both values before any non-local deployment.
MASTER_USERNAME=admin
MASTER_PASSWORD=admin

# Optional SMS/OTP configuration (feature is not wired into the main login yet).
SMS_PROVIDER=farazsms
SMS_API_KEY=
SMS_API_URL=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER=
SMS_PATTERN_CODE=

# Optional remote administration helpers.
CAFE_SERVER_IP=
CAFE_SERVER_USER=root
CAFE_SERVER_PASSWORD=
CAFE_REMOTE_PATH=/var/www/cafe
